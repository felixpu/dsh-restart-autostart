{
  "name": "dsh-restart-autostart",
  "version": "0.3.4",
  "description": "在设置面板标题栏加入「重启」按钮（任何分页都能点，免滚动）；在「设置 → 通用」加入「DSH 主程序版本」行，检查 dsh 主程序新版并一键升级（升级前自动备份，新版本起不来时先进入安全模式隔离第三方插件，仍失败才自动回滚），以及「跟随系统启动」勾选框：写入 macOS launchd / Linux systemd / Windows 服务自启条目，开机拉起并在崩溃后自动重启。",
  "icon": "icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixpu/dsh-restart-autostart.git"
  },
  "homepage": "https://github.com/felixpu/dsh-restart-autostart#readme",
  "bugs": {
    "url": "https://github.com/felixpu/dsh-restart-autostart/issues"
  },
  "author": "felixpu",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "restart",
    "autostart",
    "daemon",
    "guard"
  ],
  "license": "MIT"
}
